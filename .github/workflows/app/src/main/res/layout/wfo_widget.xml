<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="116dp"
    android:background="@drawable/widget_card_bg">

    <!-- Multi-Color Frosted Glass Backdrop Bitmap (Populated from GlassUiTheme) -->
    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="116dp"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: Day/Date Title + Status Pill + Refresh Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:maxLines="1"
                android:text="OfficePace"
                android:textColor="@color/widget_text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_neutral"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="🏠 WFH Today"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_refresh_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_pill_neutral"
                android:gravity="center"
                android:text="🔄"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Row 2: Dedicated Sub-Line for Active Office / Wi-Fi Name (Hidden When Empty) -->
        <TextView
            android:id="@+id/widget_source_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Row 3: Hero Attendance Ratio + Pace Line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_hero_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="0 / 9 days (0%)"
                android:textColor="@color/widget_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pace_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="9 needed • 11 buffer"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:layout_marginTop="8dp"
            android:max="9"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <!-- Row 5: This Week (M T W T F) Bubbles + Last Updated Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_day_mon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_day_none"
                android:gravity="center"
                android:text="M"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_day_tue"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_day_none"
                android:gravity="center"
                android:text="T"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_day_wed"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_day_none"
                android:gravity="center"
                android:text="W"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_day_thu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_day_none"
                android:gravity="center"
                android:text="T"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_day_fri"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_day_none"
                android:gravity="center"
                android:text="F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_updated_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="Updated 09:00"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
